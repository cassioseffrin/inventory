# ---- banco do Metasploit (SOMENTE LEITURA) ----
# usuário criado por sql/01-msf-readonly.sql
MSF_DATABASE_URL=postgres://inv_msf_ro:TROQUE@192.168.50.217:5432/msf

# ---- banco do inventário (leitura/escrita) ----
# usuário/banco criados por sql/02-inventario-db.sql
INV_DATABASE_URL=postgres://inv_app:TROQUE@192.168.50.21:5432/inventario

# ---- autenticação ----
# gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# true quando servido via HTTPS
COOKIE_SECURE=false

# usuário admin criado/atualizado por `npm run db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TROQUE

# opcional: prefixo de sub-rede para o painel de descoberta (padrão 24)
SUBNET_PREFIX=24

# token para o script do Kali (scripts/kali) chamar a importação em massa; mín. 32 chars. Vazio = desabilitado.
# gere com: openssl rand -hex 32
IMPORT_API_TOKEN=
